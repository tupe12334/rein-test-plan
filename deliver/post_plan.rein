interface Input {
  /** The tracker of the ticket: jira, github or linear. */
  tracker: string;
  /** The ticket key, such as ABC-123. */
  key: string;
  /** The test plan file to post, as an absolute path. */
  plan: string;
}

/**
 * The text that posts the test plan as a comment on the ticket. The tracker
 * tool is found at run time. It posts to no other place.
 */
export default function postPlan({ tracker, key, plan }: Input) {
  return `Post the test plan in ${plan} as a comment on the ticket ${key} of
    the ${tracker} tracker. For jira, use addOrEditJiraIssueComment. For github,
    take the owner, repo and number from the key owner/repo#number, and use gh
    issue comment <number> --repo <owner/repo> with the body of the file. For
    linear, use the Linear
    tools. Before posting, check that the plan has no secret, no token and no
    customer's personal data, and remove any you find. Answer posted yes when
    the comment is posted, otherwise no. Answer link: the link of the comment,
    or none. Post no other message. Post to no Slack channel.`;
}
